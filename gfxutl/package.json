{
  "name": "gfxutl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:naga": "cargo build --manifest-path core/naga-wasm/Cargo.toml --release --target wasm32-unknown-unknown && wasm-bindgen --target web --out-dir core/naga-wasm/pkg --out-name naga_wasm core/naga-wasm/target/wasm32-unknown-unknown/release/gfxutl_naga_wasm.wasm",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@vitejs/plugin-react": "latest",
    "clsx": "latest",
    "idb-keyval": "^6.3.0",
    "lucide-react": "latest",
    "mediabunny": "latest",
    "opentype.js": "^2.0.0",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "latest",
    "three": "0.186.1",
    "three.regular.helvetiker": "^1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "0.186.0",
    "typescript": "latest",
    "vite": "latest"
  }
